# Server-only. Copy to .env for npm run dev; configure these in Vercel for deployment.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=sb_secret_replace_me
# Alternatively use the legacy service_role key (never the anon/publishable key).
# SUPABASE_SERVICE_ROLE_KEY=replace_me
# Comma-separated, lowercase registered usernames allowed to view statistics.
# Register and verify these accounts before granting access.
ADMIN_USERNAMES=
# Canonical public origin for SEO metadata and sitemaps.
SITE_URL=https://perler-beads-generator.ai-toolsets.com
